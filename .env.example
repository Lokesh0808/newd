# ---------------------------------------------------------------------------
# CareerAI environment configuration
# Copy to `.env.local` and fill in the values you need.
# Every value below is OPTIONAL except DATABASE_URL — the app ships with a
# "demo mode" fallback so it boots even without API keys.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL / Supabase) --------------------------------------
# Supabase: Project Settings > Database > Connection string > URI (use the
# session pooler, port 5432, and append ?sslmode=require)
DATABASE_URL="postgresql://careerai:careerai@127.0.0.1:5432/careerai?schema=public"

# --- NextAuth --------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-in-production"
AUTH_URL="http://localhost:3000"
# Optional: enables the "Sign in with Google" button (Google Cloud Console >
# OAuth 2.0 Client ID)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Anthropic (Claude) ----------------------------------------------------
# Without this key the AI routes return deterministic demo responses so the
# product can be explored end-to-end.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# --- Stripe (Pro plan) -----------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
